# ─────────────────────────────────────────────
# mosafer-spine.de — Apache Konfiguration
# Kanonische Domain: https://www.mosafer-spine.de
# ─────────────────────────────────────────────

AddDefaultCharset UTF-8

# Hinweis: env=HTTPS liefert bei vielen Hostern kein HSTS (Scanner zeigt „fehlt“).
# REQUEST_SCHEME == https setzt HSTS nur auf TLS-Antworten (Apache 2.4+).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{REQUEST_SCHEME} == 'https'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

RewriteEngine On

# Alle Varianten auf https://www. weiterleiten (301 permanent)
# Betrifft: http://, https://, non-www, www ohne HTTPS
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.mosafer-spine\.de$ [NC]
RewriteRule ^ https://www.mosafer-spine.de%{REQUEST_URI} [R=301,L]

# Legacy-URLs der alten Website → neue Seitenstruktur (301 permanent)
RewriteRule ^diagnostik\.html$ /skoliose/erstdiagnose.html [R=301,L]
RewriteRule ^revisionschirurgie\.html$ /wirbelsaeulenchirurgie/revision.html [R=301,L]
RewriteRule ^operative-chirurgie\.html$ /skoliose/operative-behandlung.html [R=301,L]

# Restbestand der FRÜHEREN Website, der noch physisch auf dem Strato-Webspace
# liegt (17.09.2026 gefunden). Die Dateien sind nicht im Git-Repo, waren aber
# live mit "index, follow" erreichbar und enthielten veraltete Angaben
# (u. a. "Kinderorthopädie", Vogtareuth als aktuelle Position, "2.000 Eingriffe",
# alte Doctolib-Links). Ursache: deploy-mosafer-spine.sh lädt nur hoch (put -r)
# und löscht nie. Eine RewriteRule greift VOR der Dateiauslieferung, die Seiten
# sind damit unschädlich, auch solange die Dateien noch auf dem Server liegen.
RewriteRule ^kindliche-deformitaeten\.html$ /skoliose-spezialist.html [R=301,L]
RewriteRule ^skoliose-deformitaeten\.html$ /skoliose-spezialist.html [R=301,L]
RewriteRule ^konservative-therapie\.html$ /leistungen.html [R=301,L]
# Alt-Duplikat im Wurzelverzeichnis; die gültige Seite liegt unter /praxis/.
RewriteRule ^nachsorge\.html$ /praxis/nachsorge.html [R=301,L]

# Verzeichnis-URLs ohne Index-Datei → relevante Seite (vermeidet 403)
# Google entdeckt Verzeichnis-Pfade durch URL-Kürzen automatisch.
RewriteRule ^praxis/?$ /praxis/ueber-dr-mosafer.html [R=301,L]
RewriteRule ^konservativ/?$ /konservativ/prt-facettengelenksinfiltration.html [R=301,L]
RewriteRule ^skoliose/?$ /skoliose-spezialist.html [R=301,L]
# Ergänzt 17.09.2026: lieferten live 403, von Google noch nicht gemeldet.
RewriteRule ^patienten/?$ /patienten/international.html [R=301,L]
RewriteRule ^wirbelsaeulenchirurgie/?$ /leistungen.html [R=301,L]
# /en/ lieferte 200 mit dem Inhalt von home.html (Duplikat trotz korrektem
# Canonical) — sauberer als 301 auf die kanonische Adresse.
RewriteRule ^en/?$ /en/home.html [R=301,L]

# Interne Dokumentation nicht öffentlich auslieferbar
RewriteRule ^docs(/.*)?$ - [F,L]

# Alt-Upload-Reste (Site-Kopie + internes Log) → 410 Gone, damit Google deindexiert.
# Bewusst NICHT in robots.txt sperren: Google muss den 410 crawlen können.
RewriteRule ^backup_seo(/.*)?$ - [G,L]
RewriteRule ^seo_fix_log\.txt$ - [G,L]

# /index.html → / (Duplikat der Startseite vermeiden; Bedingung verhindert
# Redirect-Schleife mit DirectoryIndex)
RewriteCond %{THE_REQUEST} \s/index\.html [NC]
RewriteRule ^index\.html$ https://www.mosafer-spine.de/ [R=301,L]
